From 8659022c9cc7bdecf1f49eadbd6efbd99d9a2d98 Mon Sep 17 00:00:00 2001
From: Jose Luis Rivero <jrivero@honurobotics.com>
Date: Mon, 12 Oct 2026 12:22:55 +0200
Subject: [PATCH] Bootstrap PYTHONPATH

ament_package is installed under the install prefix and there is no
setup.sh until ros_workspace is built, so point PYTHONPATH at the
prefix's site-packages. Same patch as the ros2-gbp release repositories
carry on debian/<distro>/ament_cmake_core.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Jose Luis Rivero <jrivero@honurobotics.com>
---
 debian/rules.em | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/debian/rules.em b/debian/rules.em
index a856369..3ba9ca9 100755
--- a/debian/rules.em
+++ b/debian/rules.em
@@ -23,6 +23,10 @@ endif
 
 DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
 
+# Needed to bootstrap since the ros_workspace package does not yet exist.
+PYTHON3_VERSION=$(shell py3versions -d)
+export PYTHONPATH=@(InstallationPrefix)/lib/$(PYTHON3_VERSION)/site-packages
+
 %:
 	dh $@@ -v --buildsystem=cmake --builddirectory=.obj-$(DEB_HOST_GNU_TYPE)
 
-- 
